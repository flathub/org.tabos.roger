{
    "app-id" : "org.tabos.roger",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "roger",
    "finish-args" : [
        "--socket=fallback-x11",
        "--share=ipc",
        "--socket=wayland",
        "--share=network",
        "--filesystem=host",
        "--socket=pulseaudio",
        "--talk-name=org.freedesktop.secrets",
        "--filesystem=xdg-run/keyring",
        "--talk-name=org.gnome.evolution.dataserver.AddressBook9",
        "--talk-name=org.gnome.evolution.dataserver.Calendar7",
        "--talk-name=org.gnome.evolution.dataserver.Sources5",
        "--talk-name=org.gnome.evolution.dataserver.Subprocess.Backend.*"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/share/aclocal",
        "/man",
        "/share/man",
        "/share/gtk-doc",
        "/share/vala",
        "*.la",
        "*.a",
        "/lib/girepository-1.0",
        "/share/info",
        "/share/gtksourceview-3.0",
        "/share/doc",
        "/share/gir-1.0"
    ],
    "modules" : [
        "shared-modules/libsoup/libsoup-2.4.json",
        {
            "name" : "gssdp",
            "buildsystem" : "meson",
            "cleanup" : [
                "/bin"
            ],
	    "config-opts" : [
                "-Dgtk_doc=false",
                "-Dsniffer=false",
                "-Dintrospection=false",
                "-Dvapi=false",
                "-Dexamples=false",
                "-Dmanpages=false"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/gssdp/1.6/gssdp-1.6.4.tar.xz",
                    "sha256" : "ff97fdfb7f561d3e6813b4f6a2145259e7c2eff43cc0e63f3fd031d0b6266032"
                }
            ]
        },
        {
            "name" : "gupnp",
            "buildsystem" : "meson",
            "cleanup" : [
                "/bin"
            ],
	    "config-opts" : [
                "-Dintrospection=false",
                "-Dvapi=false",
                "-Dgtk_doc=false",
                "-Dexamples=false"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/gupnp/1.6/gupnp-1.6.9.tar.xz",
                    "sha256" : "2edb6ee3613558e62f538735368aee27151b7e09d4e2e2c51606833da801869b"
                }
            ]
        },
        {
            "name" : "ghostscript",
            "config-opts" : [
                "--disable-cups",
                "--disable-dbus",
                "--disable-gtk",
                "--without-ijs",
                "--without-luratech",
                "--without-pdftoraster",
                "--disable-compile-inits",
                "--with-system-libtiff",
                "--without-jbig2dec",
                "--without-pdf"
            ],
            "make-args" : [
                "so"
            ],
            "make-install-args" : [
                "soinstall"
            ],
            "cleanup" : [
                "/bin",
                "/share/man",
                "/share/ghostscript/10.07/doc/",
                "/share/ghostscript/10.07/examples"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs10070/ghostscript-10.07.0.tar.xz",
                    "sha256" : "ddace4e1721f967a55039baff564840225e0baa1d4f5432247ca1ccd1473b7c1"
                },
                {
                    "type": "shell",
                    "commands": [
                           "rm -rf lcms2mt jpeg libpng openjpeg zlib",
                           "cp -p /usr/share/automake-*/config.{sub,guess} freetype/builds/unix/"
                    ]
                }
            ]
        },
        {
            "name": "libical",
            "cleanup": [ "/lib/cmake" ],
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS:BOOL=ON",
                "-DGOBJECT_INTROSPECTION:BOOL=OFF",
                "-DCMAKE_INSTALL_LIBDIR:PATH=/app/lib",
                "-DICAL_BUILD_DOCS:BOOL=OFF",
                "-DICAL_GLIB_VAPI:BOOL=OFF",
                "-DICAL_GLIB:BOOL=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libical/libical/releases/download/v3.0.20/libical-3.0.20.tar.gz",
                    "sha256": "e73de92f5a6ce84c1b00306446b290a2b08cdf0a80988eca0a2c9d5c3510b4c2"
                 }
            ]
        },
        "shared-modules/intltool/intltool-0.51.json",
        {
            "name" : "evolution-data-server",
            "cleanup" : [
                "/lib/cmake",
                "/lib/evolution-data-server/*-backends",
                "/libexec",
                "/share/dbus-1/services"
            ],
            "config-opts" : [
                "-DENABLE_GTK=OFF",
                "-DENABLE_GOOGLE_AUTH=OFF",
                "-DENABLE_UOA=OFF",
                "-DENABLE_GOOGLE=OFF",
                "-DENABLE_OAUTH2=OFF",
                "-DENABLE_VALA_BINDINGS=OFF",
                "-DWITH_OPENLDAP=OFF",
                "-DENABLE_INTROSPECTION=OFF",
                "-DENABLE_INSTALLED_TESTS=OFF",
                "-DENABLE_GTK_DOC=OFF",
                "-DENABLE_EXAMPLES=OFF",
                "-DENABLE_GOA=OFF",
                "-DENABLE_WEATHER=OFF",
                "-DWITH_LIBDB=OFF",
                "-DENABLE_CANBERRA=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/evolution-data-server/3.56/evolution-data-server-3.56.2.tar.xz",
                    "sha256" : "df4ec29950f29a76eac6fbe0f814c48d2cef7d3fdb905002a4a883dd761ce93c"
                }
            ]
        },
        {
            "name" : "capi20",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.com/tabos/libcapi.git",
                    "tag" : "v3.2.3",
                    "commit" : "9e7eb7789fef8ce712aa64f290aacbbececf2dfe"
                }
            ]
        },
        {
            "name" : "spandsp",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.com/tabos/spandsp.git",
                    "tag" : "0.0.6pre21",
                    "commit" : "68455c2d0d56def0443ba2ae7df0e82e3a5fa5bb"
                },
                {
                    "type": "shell",
                    "commands": [
                        "cp -p /usr/share/automake-*/config.{sub,guess} config"
                    ]
                }
            ]
        },
        {
            "name" : "librm",
            "buildsystem" : "meson",
            "config-opts" : [
                "--libdir=/app/lib",
                "--buildtype=release"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.com/tabos/librm.git",
                    "commit" : "8517ef7e6c530952b71636296da290afab60e4c5"
                 }
            ]
        },
        {
            "name" : "roger",
            "config-opts" : [
                "--libdir=/app/lib",
                "--buildtype=release"
            ],
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.com/tabos/rogerrouter.git",
                    "commit" : "8c754a64fcc45ed8a07570f37acdb2b312856fa1"
                }
            ]
        }
    ]
}
